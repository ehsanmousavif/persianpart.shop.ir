{
  "name": "@persianpart/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts"
    },
    "./router": {
      "types": "./src/routers/index.ts",
      "import": "./src/routers/index.ts"
    }
  },
  "scripts": {
    "dev": "cross-env PORT=5149 next dev -p 5149",
    "build": "next build",
    "start": "cross-env PORT=5149 next start -p 5149",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@orpc/client": "2.0.0-beta.42",
    "@orpc/contract": "2.0.0-beta.42",
    "@orpc/openapi": "2.0.0-beta.42",
    "@orpc/server": "2.0.0-beta.42",
    "@persianpart/cms": "workspace:*",
    "@persianpart/contract": "workspace:*",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3"
  }
